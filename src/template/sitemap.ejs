<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc><%= homeUrl %></loc>
  </url>
  <% articleList.forEach(({ url, lastmod }) => { %>
    <url>
      <loc><%= url %></loc>
      <% if (lastmod) { %>
        <lastmod><%= lastmod %></lastmod>
      <% } %>
    </url>
  <% }) %>
</urlset>
